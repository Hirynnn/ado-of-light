{
  "name": "ado-of-light",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Publica diariamente no Discord o ranking de compras do mercado de Final Fantasy XIV.",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "format": "prettier --write \"**/*.{ts,json,jsonc,yml,md}\"",
    "format:check": "prettier --check \"**/*.{ts,json,jsonc,yml,md}\"",
    "start": "node --env-file-if-exists=.env dist/src/server.js",
    "job:daily": "npm run build && node --env-file-if-exists=.env dist/src/jobs/run-publish.js"
  },
  "devDependencies": {
    "@types/node": "^24.10.0",
    "prettier": "^3.6.2",
    "typescript": "^5.9.3",
    "vitest": "^4.1.11"
  }
}
